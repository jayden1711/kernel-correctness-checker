# Dev environment (machine-local)
/venv/
/.venv/
/.driveignore
/.claude/

# IDE
.idea/
.vscode/

# Python packaging / build artifacts (anchored: 'bin', 'lib', 'build', 'dist',
# 'var' are ordinary words that must not swallow a future source dir)
/bin/
/build/
/develop-eggs/
/dist/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/.installed.cfg
*.egg-info/
*.egg

# Byte-compiled / optimized
__pycache__/
*.py[cod]

# Triton JIT cache (created at any cwd)
.triton/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Cloned upstream repos (root-level only)
/TritonBench_G_repo/
/KernelBench/

# Secrets — deliberately unanchored: a .env at any depth must never be committed
.env

# Adversarial search output dir (scripts/run_adversarial_search.py default)
/adversarial_results/

/search_history.db

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Runtime/console logs
*.log
!verification_runs/**/*.log
/triton_kernel_logs/
/random_baseline_report.json

# LLM / litellm cache (created at any cwd)
.litellm_cache/
litellm_cache/

# GPU-session cache store + per-session downloaded results (scripts/colab_bench.sh)
/.triton_cache_store/
/results_gpu/
