# Copy to .env and fill in the key matching your --model flag.

ANTHROPIC_API_KEY=sk-ant-...    # claude-* models
OPENAI_API_KEY=sk-...           # gpt-* models
DEEPSEEK_API_KEY=...            # deepseek/deepseek-chat etc.
GEMINI_API_KEY=...              # gemini/gemini-2.5-flash etc.
MISTRAL_API_KEY=...             # mistral/* models

# Project root — defaults to cwd if unset
# CHECKER_ROOT=/path/to/kernel-correctness-checker